                        cream: {
                            50: '#FCF9F5',
                            100: '#FAF6F0', // Light Surface
                            200: '#EEE0CC', // Primary Warm Cream Qowwamoon
                            300: '#e2cbb0',
                            400: '#d2b08c',
                            500: '#c2976d',
