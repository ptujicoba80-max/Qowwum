        function initCropCanvasDragEvents() {
            const canvas = document.getElementById('avatarCropCanvas');
            if (!canvas) return;

            const getScaleFactor = () => {
                const rect = canvas.getBoundingClientRect();
                return rect.width > 0 ? (canvas.width / rect.width) : 1;
            };

            const startDrag = (clientX, clientY) => {
                if (!rawSourceImage) return;
                isDraggingCanvas = true;
                const factor = getScaleFactor();
                dragStartX = clientX * factor - cropPanX;
                dragStartY = clientY * factor - cropPanY;
            };

            const moveDrag = (clientX, clientY) => {
                if (!isDraggingCanvas || !rawSourceImage) return;
                const factor = getScaleFactor();
                cropPanX = clientX * factor - dragStartX;
                cropPanY = clientY * factor - dragStartY;
                renderCropCanvas();
            };

            const endDrag = () => {
                isDraggingCanvas = false;
                initialPinchDist = null;
            };

            canvas.addEventListener('mousedown', e => startDrag(e.clientX, e.clientY));
            window.addEventListener('mousemove', e => moveDrag(e.clientX, e.clientY));
            window.addEventListener('mouseup', endDrag);

            // Mouse wheel zoom directly inside the crop box
            canvas.addEventListener('wheel', e => {
                if (!rawSourceImage) return;
                e.preventDefault();
                const delta = e.deltaY < 0 ? 0.12 : -0.12;
                stepCropZoom(delta);
            }, { passive: false });

            // Touch drag & two-finger pinch-to-zoom like WhatsApp
            canvas.addEventListener('touchstart', e => {
                if (!rawSourceImage) return;
                if (e.touches.length === 1) {
                    startDrag(e.touches[0].clientX, e.touches[0].clientY);
                } else if (e.touches.length === 2) {
                    isDraggingCanvas = false;
                    const dx = e.touches[0].clientX - e.touches[1].clientX;
                    const dy = e.touches[0].clientY - e.touches[1].clientY;
                    initialPinchDist = Math.hypot(dx, dy);
                    initialPinchZoom = cropZoom;
                }
            }, { passive: true });

            canvas.addEventListener('touchmove', e => {
                if (!rawSourceImage) return;
                if (e.touches.length === 1 && isDraggingCanvas) {
                    moveDrag(e.touches[0].clientX, e.touches[0].clientY);
                } else if (e.touches.length === 2 && initialPinchDist) {
                    const dx = e.touches[0].clientX - e.touches[1].clientX;
                    const dy = e.touches[0].clientY - e.touches[1].clientY;
                    const dist = Math.hypot(dx, dy);
                    const ratio = dist / initialPinchDist;
                    cropZoom = Math.max(1, Math.min(3.5, initialPinchZoom * ratio));
                    renderCropCanvas();
                }
            }, { passive: true });

            canvas.addEventListener('touchend', endDrag);
        }

