    <style>
        body {
            background-color: #FAF6F0;
            color: #2a3226;
            font-family: 'Inter', 'Cairo', sans-serif;
        }
        .arabic-calligraphy {
            font-family: 'Cairo', 'Amiri', serif;
        }
        .khot-riqah {
            font-family: 'Aref Ruqaa', serif;
            line-height: 1.3;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #FAF6F0;
        }
        ::-webkit-scrollbar-thumb {
            background: #607456;
            border-radius: 9999px;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.94);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(96, 116, 86, 0.18);
        }
        .pattern-bg {
            background-color: #607456;
            background-image: none;
        }
        .org-line-v {
            width: 2px;
            background-color: #607456;
            margin: 0 auto;
        }
        html, body {
            max-width: 100%;
            overflow-x: hidden;
        }
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        @media print {
            body * {
                visibility: hidden;
            }
            #philosophyPrintableArea, #philosophyPrintableArea * {
                visibility: visible;
            }
            #philosophyPrintableArea {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }
