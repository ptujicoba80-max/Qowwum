    <!-- =====================================================
         1. ENTRY GATE OVERLAY (LOGIN THULLAB, TAMU & PORTAL MAS'UL)
         ===================================================== -->
    <div id="entryGateOverlay" class="fixed inset-0 z-[90] bg-cream-100 flex flex-col justify-between p-4 sm:p-6 overflow-y-auto">
