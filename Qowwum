            const cat = document.getElementById('adminBankCatInput').value.trim() || "Bank Soal";
            const title = document.getElementById('adminBankTitleInput').value.trim();
            const url = document.getElementById('adminBankUrlInput').value.trim();

            if (!title) {
                showToast("Masukkan judul soal / materi terlebih dahulu.", "error");
                return;
            }
            if (!url && tempAdminBankFiles.length === 0) {
                showToast("Masukkan Link URL atau pilih file (Foto/PDF) untuk diunggah.", "error");
                return;
            }

            if (tempAdminBankFiles.length > 0) {
                tempAdminBankFiles.forEach((f, idx) => {
                    customBankSoal.unshift({
                        id: "bsoal-" + Date.now() + "-" + idx,
                        mustawa,
                        maddah,
                        cat,
                        title: tempAdminBankFiles.length > 1 ? `${title} (${idx + 1})` : title,
                        fileName: f.name,
                        fileType: f.type,
                        dataUrl: f.dataUrl
                    });
                });
            } else {
                customBankSoal.unshift({
                    id: "bsoal-" + Date.now(),
                    mustawa,
                    maddah,
                    cat,
                    title,
                    url
                });
