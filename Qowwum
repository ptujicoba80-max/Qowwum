                <h1 class="text-2xl sm:text-3xl font-extrabold tracking-wider text-olive-900">QOWWAMOON</h1>
                <p class="text-xs sm:text-sm font-extrabold italic text-[#607456]">"Beyond the Moon, Being Qowwamoon"</p>
                <p class="text-[11px] font-bold text-olive-600" data-i18n="syariahBatch">Syariah Angkatan 58 — LIPIA Jakarta</p>
            </div>

            <!-- Side-by-Side Thullab & Guest Boxes (Clean without numbers or long helper text) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
                <!-- Thullab Box -->
                <div class="glass-card rounded-3xl p-5 sm:p-6 shadow-md border-2 border-[#607456] flex flex-col justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-2xl bg-[#607456] text-cream-100 flex items-center justify-center text-base shrink-0">
                            <i class="fa-solid fa-user-graduate"></i>
                        </div>
                        <h2 class="text-base sm:text-lg font-extrabold text-olive-900" data-i18n="optThullabTitle">Thullab Qowwamoon</h2>
                    </div>
                    <form onsubmit="event.preventDefault(); enterAsThullab();" class="space-y-2.5">
                        <input type="text" id="gateRoqmInput" inputmode="numeric" data-i18n-placeholder="roqmPlaceholder" placeholder="Roqm Jamii..." class="w-full bg-cream-100 border border-olive-300 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm font-extrabold text-olive-900 focus:outline-none focus:ring-2 focus:ring-[#607456]">
                        <button type="submit" class="w-full bg-[#607456] hover:bg-olive-700 text-cream-100 font-extrabold py-2.5 px-4 rounded-xl text-xs sm:text-sm shadow transition flex items-center justify-center gap-2 cursor-pointer">
                            <i class="fa-solid fa-right-to-bracket"></i>
                            <span data-i18n="btnLoginThullab">Masuk</span>
                        </button>
                    </form>
                </div>

                <!-- Guest Box -->
