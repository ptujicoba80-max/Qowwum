                <div class="flex items-center gap-1 sm:gap-2 shrink-0">
                    <!-- High-contrast simple ID | AR | EN switcher -->
                    <div class="inline-flex items-center bg-olive-700/90 p-0.5 rounded-xl border border-cream-200/30">
                        <button type="button" onclick="setLanguage('id')" class="lang-pill px-1.5 sm:px-2.5 py-1 rounded-lg text-[9px] sm:text-[10px] font-extrabold transition" data-lang="id">ID</button>
                        <button type="button" onclick="setLanguage('ar')" class="lang-pill px-1.5 sm:px-2.5 py-1 rounded-lg text-[9px] sm:text-[10px] font-extrabold transition" data-lang="ar">AR</button>
                        <button type="button" onclick="setLanguage('en')" class="lang-pill px-1.5 sm:px-2.5 py-1 rounded-lg text-[9px] sm:text-[10px] font-extrabold transition" data-lang="en">EN</button>
