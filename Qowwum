        function shiftBerandaCalendarMonth(delta) {
            berandaCalMonth += delta;
            if (berandaCalMonth > 11) {
                berandaCalMonth = 0;
                berandaCalYear++;
            } else if (berandaCalMonth < 0) {
                berandaCalMonth = 11;
                berandaCalYear--;
            }
            renderBerandaMiniCalendar();
        }

        function renderBerandaMiniCalendar() {
            const labelEl = document.getElementById('berandaCalMonthLabel');
            const gridEl = document.getElementById('berandaMiniCalendarGrid');
            if (!labelEl || !gridEl) return;

            const firstDay = new Date(berandaCalYear, berandaCalMonth, 1);
            const lastDay = new Date(berandaCalYear, berandaCalMonth + 1, 0);
            const monthName = firstDay.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
            labelEl.textContent = monthName;

            const dayHeaders = ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'];
            let html = dayHeaders.map((d, i) => `
                <div class="py-1.5 font-extrabold text-[10px] uppercase ${i === 0 || i === 6 ? 'text-rose-600' : 'text-olive-500'}">${d}</div>
            `).join('');

            const startDow = firstDay.getDay();
            for (let b = 0; b < startDow; b++) {
                html += `<div class="p-2"></div>`;
            }

            const now = new Date();
            const todayIso = [
                now.getFullYear(),
                String(now.getMonth() + 1).padStart(2, '0'),
                String(now.getDate()).padStart(2, '0')
            ].join('-');

            for (let day = 1; day <= lastDay.getDate(); day++) {
                const iso = [
                    berandaCalYear,
                    String(berandaCalMonth + 1).padStart(2, '0'),
                    String(day).padStart(2, '0')
                ].join('-');
                const dow = new Date(berandaCalYear, berandaCalMonth, day).getDay();
                const isToday = iso === todayIso;
                const isExamDay = examList.some(e => e.startIso.startsWith(iso));
                const isHoliday = Boolean(indonesianNationalHolidays[iso] || (getTaqwimDirosiStatusForDate(iso)?.kind === 'holiday'));

                let cellStyle = "bg-cream-50 text-olive-900 border border-olive-100";
                if (isToday) {
                    cellStyle = "bg-[#607456] text-white font-extrabold shadow-sm";
                } else if (isExamDay) {
                    cellStyle = "bg-amber-100 text-amber-900 border border-amber-300 font-extrabold";
                } else if (isHoliday || dow === 0 || dow === 6) {
                    cellStyle = "bg-rose-50 text-rose-700 border border-rose-200/70";
                }

                html += `
                    <div class="py-2 rounded-xl text-xs font-bold flex flex-col items-center justify-center ${cellStyle}">
                        <span>${day}</span>
                        ${isExamDay ? `<span class="w-1.5 h-1.5 rounded-full bg-amber-600 mt-0.5"></span>` : ''}
                    </div>
                `;
            }

            gridEl.innerHTML = html;
        }

