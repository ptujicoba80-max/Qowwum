        </div>

        <!-- Center Card: Logo + Side-by-Side Thullab & Guest Cards + Mas'ul Portal Button -->
        <div class="max-w-2xl w-full mx-auto my-auto py-4 space-y-6 text-center">
            <!-- Brand Emblem (Static on Front Gate) -->
