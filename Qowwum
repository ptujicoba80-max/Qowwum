        // BERANDA REMINDER DASHBOARD & OFFICIAL JAM MUHADHOROT (SENIN-KAMIS VS JUMAT)
        // =====================================================
        // Exact Jam Muhadhorot (مواعيد المحاضرات - الفترة الصباحية) matching jam hissoh.jpeg:
        // Senin - Kamis: 1 (07.00-07.50), 2 (07.55-08.45), 3 (08.50-09.40), [Istirahat: 09.40-10.10], 4 (10.10-11.00), 5 (11.05-11.50)
        // Jumat:         1 (07.00-07.45), 2 (07.50-08.35), 3 (08.40-09.25), [Istirahat: 09.25-09.55], 4 (09.55-10.40), 5 (10.45-11.30)
        const sessionTimeRangesMonThu = [
            "07.00 - 07.50",
            "07.55 - 08.45",
            "08.50 - 09.40",
            "10.10 - 11.00",
            "11.05 - 11.50"
        ];
        const sessionTimeRangesFri = [
            "07.00 - 07.45",
            "07.50 - 08.35",
            "08.40 - 09.25",
            "09.55 - 10.40",
            "10.45 - 11.30"
        ];

        function getSessionTimeForDayAndSlot(dayIdx, slotIdxZeroBased) {
            if (Number(dayIdx) === 5) {
                return sessionTimeRangesFri[slotIdxZeroBased] || "07.00 - 07.45";
            }
            return sessionTimeRangesMonThu[slotIdxZeroBased] || "07.00 - 07.50";
        }

