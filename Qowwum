        function getStudentMaddahStats(studentId, maddahKey) {
            let ghoib = 0;
            const suffix = `__${maddahKey}`;
            Object.keys(maddahAttendanceLogs).forEach(sessionKey => {
                if (sessionKey.endsWith(suffix)) {
                    const status = maddahAttendanceLogs[sessionKey]?.[studentId];
                    if (status === 'Ghoib') ghoib++;
                }
            });
            const maxGhoib = maddahCatalog[maddahKey]?.maxGhoib || 4;
            const remaining = Math.max(0, maxGhoib - ghoib);
            const pct = Math.min(100, Math.round((ghoib / maxGhoib) * 100));
            return { ghoib, maxGhoib, remaining, pct };
        }

        function getStudentTotalAttendanceStats(studentId) {
            let totalGhoib = 0;
            const warnings = [];
            Object.keys(maddahCatalog).forEach(mKey => {
                const st = getStudentMaddahStats(studentId, mKey);
                totalGhoib += st.ghoib;
                if (st.pct >= 50) {
                    warnings.push({ maddahKey: mKey, ...st });
                }
            });
            return { totalGhoib, warnings };
        }

