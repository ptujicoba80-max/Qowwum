                <button type="button" onclick="setLanguage('ar')" class="lang-pill px-2.5 py-1 rounded-lg text-[10px] sm:text-xs font-extrabold transition text-cream-100 hover:bg-olive-500/60" data-lang="ar">AR</button>
                <button type="button" onclick="setLanguage('en')" class="lang-pill px-2.5 py-1 rounded-lg text-[10px] sm:text-xs font-extrabold transition text-cream-100 hover:bg-olive-500/60" data-lang="en">EN</button>
