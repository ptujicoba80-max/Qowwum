        function renderKasSpreadsheet() {
            // Calculate 2027 totals across all 9 active months + Previous Year Income (Carry-over)
            let totalMonthsPaidAll = 0;
            let countPaidStudents = 0;
            students.forEach(s => {
                const mCount = KAS_MONTHS_2027.reduce((acc, m) => acc + (s[m.key] ? 1 : 0), 0);
                totalMonthsPaidAll += mCount;
                if (mCount > 0) countPaidStudents++;
            });

            const currentYearIn = totalMonthsPaidAll * MONTHLY_FEE;
            const totalIn = currentYearIn + (Number(prevYearIncome) || 0);
            const totalOut = expenses.reduce((a, b) => a + b.amount, 0);
            const netBalance = totalIn - totalOut;

            const inEl = document.getElementById('kasTotalMasuk');
