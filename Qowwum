            tomorrow.setDate(now.getDate() + 1);
            let targetDayIdx = tomorrow.getDay(); // 0=Sun..6=Sat
            let dayOffset = 1;
            if (targetDayIdx === 6) { // Saturday -> show Monday
                targetDayIdx = 1;
                dayOffset = 3;
            } else if (targetDayIdx === 0) { // Sunday -> show Monday
