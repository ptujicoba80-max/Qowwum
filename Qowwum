                        </div>
                        <h2 class="text-base sm:text-lg font-extrabold text-olive-900" data-i18n="optGuestTitle">Tamu</h2>
                    </div>
                    <button type="button" onclick="enterAsGuest()" class="w-full bg-cream-200 hover:bg-[#607456] text-olive-900 hover:text-cream-100 font-extrabold py-2.5 px-4 rounded-xl text-xs sm:text-sm border border-olive-300 transition flex items-center justify-center gap-2 cursor-pointer">
                        <i class="fa-solid fa-door-open"></i>
                        <span data-i18n="btnEnterGuest">Masuk Tamu</span>
                    </button>
                </div>
            </div>

            <!-- Dedicated Mas'ul Attendance Portal Trigger Below the 2 Boxes -->
            <div class="pt-1">
                <button type="button" onclick="requestMasulAccess()" class="inline-flex items-center justify-center gap-2 bg-white hover:bg-[#607456] text-olive-800 hover:text-cream-100 font-extrabold px-5 py-2.5 rounded-2xl text-xs border border-olive-300 shadow-xs transition cursor-pointer">
                    <i class="fa-solid fa-user-check"></i>
                    <span data-i18n="btnGateMasul">Portal Khusus Mas'ul Absensi</span>
                </button>
            </div>
        </div>

        <div class="text-center text-[11px] font-bold text-olive-500">
            QOWWAMOON • Syariah 58 LIPIA Jakarta
        </div>
