                            </div>
                            <h4 class="font-extrabold text-sm sm:text-base ${isCompleted ? 'line-through text-olive-600' : 'text-olive-900'}">${eTitle}</h4>
                            <p class="text-xs font-bold text-olive-700">
                                <i class="fa-regular fa-calendar-check mr-1 text-[#607456]"></i> ${dDisp} • <span class="text-[#607456] font-extrabold">${ex.timeDisplay}</span>
                            </p>
