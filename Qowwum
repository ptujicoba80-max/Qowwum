                        ${rightBox}
                    </div>
                `;
            };

            const utsBox = document.getElementById('utsScheduleContainer');
            if (utsBox) {
                utsBox.innerHTML = examList.filter(e => e.type === 'uts').map(renderExamCard).join('');
