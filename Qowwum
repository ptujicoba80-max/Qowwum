        function recalculateMaddahWeeklySaahAndHirman() {
            const counts = {};
            Object.keys(maddahCatalog).forEach(k => counts[k] = 0);
            [1, 2, 3, 4, 5].forEach(d => {
                (weeklyScheduleByDay[d] || []).forEach(slot => {
                    if (slot.maddahKey && maddahCatalog[slot.maddahKey]) {
                        counts[slot.maddahKey] = (counts[slot.maddahKey] || 0) + 1;
                    }
                });
            });
            Object.keys(maddahCatalog).forEach(k => {
                const saah = counts[k] || maddahCatalog[k].weeklySaah || 2;
                const limit = saah * 3; // 3x SKS
                maddahCatalog[k].weeklySaah = saah;
                maddahCatalog[k].maxGhoib = limit;
                maddahCatalog[k].kitabs = {
                    id: `${saah} Sa'ah/Pekan • Batas Hirman: ${limit}x Ghoib`,
                    ar: `${saah} ساعات أسبوعياً • حد الحرمان: ${limit} غيابات`,
                    en: `${saah} Hours/Week • Hirman Limit: ${limit}x`
                };
            });
        }

