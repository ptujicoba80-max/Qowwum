        // WHATSAPP-STYLE DIRECT BOX CROP, DRAG, PINCH/WHEEL ZOOM & FILTER ENGINE (NO SLIDERS)
        let rawSourceImage = null;
        let currentPhotoFilter = 'none';
        let cropZoom = 1;
        let cropPanX = 0;
        let cropPanY = 0;
        let isDraggingCanvas = false;
        let dragStartX = 0;
        let dragStartY = 0;
        let initialPinchDist = null;
        let initialPinchZoom = 1;

        function handleModalPhotoFile(event) {
            const file = event.target.files?.[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function (e) {
                const img = new Image();
                img.onload = function () {
                    rawSourceImage = img;
                    currentPhotoFilter = 'none';
                    cropZoom = 1;
                    cropPanX = 0;
                    cropPanY = 0;
                    document.getElementById('photoAdjusterStudio').classList.remove('hidden');
                    highlightActiveFilterButton('none');
                    renderCropCanvas();
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function stepCropZoom(delta) {
            if (!rawSourceImage) return;
            cropZoom = Math.max(1, Math.min(3.5, cropZoom + delta));
            clampCropPan();
            renderCropCanvas();
        }

        function clampCropPan() {
            if (!rawSourceImage) return;
            const cw = 320;
            const ch = 320;
            const baseScale = Math.max(cw / rawSourceImage.width, ch / rawSourceImage.height);
            const finalScale = baseScale * cropZoom;
            const drawW = rawSourceImage.width * finalScale;
            const drawH = rawSourceImage.height * finalScale;
            const maxOffsetX = Math.max(0, (drawW - cw) / 2);
            const maxOffsetY = Math.max(0, (drawH - ch) / 2);
            cropPanX = Math.max(-maxOffsetX, Math.min(maxOffsetX, cropPanX));
            cropPanY = Math.max(-maxOffsetY, Math.min(maxOffsetY, cropPanY));
        }

        function setPhotoFilter(filterCss) {
            currentPhotoFilter = filterCss;
            highlightActiveFilterButton(filterCss);
            renderCropCanvas();
        }

        function highlightActiveFilterButton(filterCss) {
            const map = {
                'none': 'filterBtn-none',
                'grayscale(100%)': 'filterBtn-bw',
                'sepia(85%)': 'filterBtn-sepia',
                'contrast(118%) brightness(105%)': 'filterBtn-contrast',
                'sepia(35%) saturate(135%) brightness(103%)': 'filterBtn-warm'
            };
            document.querySelectorAll('.photo-filter-btn').forEach(btn => {
                btn.className = "photo-filter-btn px-2.5 py-1 rounded-lg text-[11px] font-bold bg-white text-olive-800 border border-olive-200 transition";
            });
            const activeId = map[filterCss];
            const activeBtn = document.getElementById(activeId);
            if (activeBtn) {
                activeBtn.className = "photo-filter-btn px-2.5 py-1 rounded-lg text-[11px] font-extrabold bg-[#607456] text-cream-100 shadow-xs transition";
            }
        }

        function resetPhotoAdjuster() {
            if (!rawSourceImage) return;
            currentPhotoFilter = 'none';
            cropZoom = 1;
            cropPanX = 0;
            cropPanY = 0;
            highlightActiveFilterButton('none');
            renderCropCanvas();
        }

        function renderCropCanvas() {
            if (!rawSourceImage) return;
            const canvas = document.getElementById('avatarCropCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const cw = canvas.width;
            const ch = canvas.height;

            clampCropPan();

            ctx.clearRect(0, 0, cw, ch);
            ctx.save();
            ctx.filter = currentPhotoFilter;

            const baseScale = Math.max(cw / rawSourceImage.width, ch / rawSourceImage.height);
            const finalScale = baseScale * cropZoom;
            const drawW = rawSourceImage.width * finalScale;
            const drawH = rawSourceImage.height * finalScale;
            const drawX = (cw - drawW) / 2 + cropPanX;
            const drawY = (ch - drawH) / 2 + cropPanY;

            ctx.drawImage(rawSourceImage, drawX, drawY, drawW, drawH);
            ctx.restore();

